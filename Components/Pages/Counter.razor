@page "/counter/{initialCount:int?}"
@page "/counter2"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

@* This component demonstrates data binding, event handling, and component parameters. *@
<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="() => currentCount++">Click me</button>
<MyButton onclick="() => currentCount++" class="btn btn-success">My Button</MyButton>

<div class="mt-3">
    <input @bind="text" @bind:event="oninput" @bind:after="Search">
    <button @onclick="OnClick">Clear</button>
    <p>@text</p>
</div>

@if (currentCount > 3)
{
    <p>You win!</p>
}

<ul>
    @for (int i = 0; i < currentCount; i++)
    {
        <li>Clicked!</li>
    }
</ul>

<p>InitialCount=@InitialCount</p>

<div class="mt-3">
    <input @oninput="OnInput" />
    <p>@text</p>
    <p>@searchResult</p>
</div>

@* <div style="background-color:lightblue" @onmouseover="MouseOver" @onmouseout="MouseOut">@divText</div> *@

@code {
    private int currentCount = 0;

    string text = "";

    string searchResult = "";

    protected override void OnInitialized()
    {
        currentCount = InitialCount;
    }

    [Parameter]
    public int InitialCount { get; set; }

    [Parameter]
    public int IncrementAmount { get; set; } = 1;

    private void IncrementCount()
    {
        currentCount += IncrementAmount;
    }

    async Task IncrementCountAsync()
    {
        await Task.Delay(1000);
        currentCount++;
    }

    private void OnInput(ChangeEventArgs e)
    {
        text = (string)e.Value!;
    }

    // private void OnChange(ChangeEventArgs e)
    // {
    //     text = (string)e.Value!;
    // }

    private void OnClick(MouseEventArgs e)
    {
        text = "";
    }

    async Task Search()
    {
        searchResult = "Searching...";
        await Task.Delay(2000);
        searchResult = $"Found {Random.Shared.Next()} results!";
    }
}
